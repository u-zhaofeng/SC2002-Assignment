    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="diff_title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#1F2937;" value="Stage 2 → Stage 3 | Class Diagram Differences" vertex="1">
          <mxGeometry height="55" width="1650" x="50" y="30" as="geometry" />
        </mxCell>
        <mxCell id="diff_intro" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=16;fontColor=#475569;" value="This page compares the attached Stage 2 diagram with the project’s Stage 3 class structure. Orange on page 1 marks the complete Stage 3 delta; the earlier green Stage 2 highlights are retained." vertex="1">
          <mxGeometry height="60" width="1650" x="50" y="95" as="geometry" />
        </mxCell>
        <mxCell id="diff_new_classes" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FCE4D6;strokeColor=#D79B00;fontColor=#263238;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" value="&lt;b&gt;New Stage 3 classes&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Host&lt;/b&gt; adds independent seating task selection.&lt;br&gt;&lt;b&gt;SeatingService&lt;/b&gt; centralizes seating validation and customer/table/queue updates.&lt;br&gt;&lt;b&gt;ComboMeal&lt;/b&gt; extends MenuItem, holds first and second MenuItem references, and adds a constructor plus component getters.&lt;br&gt;&lt;b&gt;HappyHourPolicy&lt;/b&gt; owns activation, duration, discount calculation, and satisfaction recovery rules." vertex="1">
          <mxGeometry height="300" width="790" x="50" y="185" as="geometry" />
        </mxCell>
        <mxCell id="diff_existing_classes" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#263238;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" value="&lt;b&gt;Existing classes changed&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;RestaurantRushGame&lt;/b&gt;: adds Host and HappyHourPolicy fields; registers ComboMeal; adds processHostChoice() and processHappyHourChoice(turnNo); changes DefaultGameSetup(), StartGame(), displayGameState(int), and processWaiterChoice(int) to coordinate seating, discounts, and recovery.&lt;br&gt;&lt;br&gt;&lt;b&gt;Waiter&lt;/b&gt;: adds a SeatingService field; seatCustomer() now delegates to it; adds takeOrder(table, item, billCents).&lt;br&gt;&lt;br&gt;&lt;b&gt;Customer&lt;/b&gt;: the existing setOrder(item) delegates to a new setOrder(item, billCents) overload, allowing a calculated amount to be stored in Order." vertex="1">
          <mxGeometry height="390" width="825" x="875" y="185" as="geometry" />
        </mxCell>
        <mxCell id="diff_relationships" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FCE4D6;strokeColor=#D79B00;fontColor=#263238;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" value="&lt;b&gt;New structural links&lt;/b&gt;&lt;br&gt;&lt;br&gt;RestaurantRushGame owns Host and HappyHourPolicy.&lt;br&gt;Host and Waiter each delegate seating through SeatingService.&lt;br&gt;ComboMeal inherits from MenuItem and contains its first and second MenuItem references.&lt;br&gt;&lt;br&gt;&lt;b&gt;New method dependencies&lt;/b&gt;&lt;br&gt;&lt;br&gt;Host and SeatingService use WaitingQueue, Table, and Customer. HappyHourPolicy uses Customer and MenuItem for pricing, and WaitingQueue and Table for satisfaction recovery." vertex="1">
          <mxGeometry height="360" width="790" x="50" y="525" as="geometry" />
        </mxCell>
        <mxCell id="diff_behavior" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#263238;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" value="&lt;b&gt;Stage 3 behavior visible in the new signatures&lt;/b&gt;&lt;br&gt;&lt;br&gt;Happy Hour can be activated once and lasts two turns. It adds a 20% discount after the customer’s own pricing rule and restores 15 satisfaction points for queued or seated customers who are still waiting.&lt;br&gt;&lt;br&gt;ComboMeal combines two menu items, sums their preparation units, and prices the combined items at 90% of their total." vertex="1">
          <mxGeometry height="260" width="825" x="875" y="625" as="geometry" />
        </mxCell>
        <mxCell id="diff_color_key" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#334155;fontSize=15;align=center;verticalAlign=middle;shadow=0;" value="&lt;b&gt;Color key&lt;/b&gt; &amp;nbsp; &lt;span style=&quot;background-color:#D5E8D4;&quot;&gt;Green&lt;/span&gt; = Stage 2 additions already shown in the attached diagram. &amp;nbsp; &lt;span style=&quot;background-color:#FCE4D6;&quot;&gt;Orange&lt;/span&gt; = additions and changes introduced in Stage 3." vertex="1">
          <mxGeometry height="70" width="1650" x="50" y="930" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
